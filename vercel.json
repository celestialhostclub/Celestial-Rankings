{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/treinos",
      "destination": "/index.html"
    },
    {
      "source": "/rankings",
      "destination": "/index.html"
    },
    {
      "source": "/sobre-nos",
      "destination": "/index.html"
    },
    {
      "source": "/area-de-membros",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/keepalive$).*)",
      "has": [
        {
          "type": "host",
          "value": "celestial-rankings.vercel.app"
        }
      ],
      "destination": "https://celestialhost.org/:path",
      "permanent": true
    }
  ]
}
